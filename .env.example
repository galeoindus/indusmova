# indusmova — environment template
#
# Copy this file to `.env` for local work (it is git-ignored), or paste the
# same names into Cloudflare Pages → Settings → Environment variables.
# Never commit real keys: `.env` is ignored on purpose.
#
# Six OpenRouter keys are supported. The chat sends each request to a
# different key in rotation, so one key's rate limit does not stall the
# answers, and if a key is refused the request moves to the next one.
# Leave a slot empty to run with fewer keys — the rotation simply skips it.

OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
OPENROUTER_KEY_4=
OPENROUTER_KEY_5=
OPENROUTER_KEY_6=

# Which model answers. Any OpenRouter model id works.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Sent as the HTTP-Referer / X-Title that OpenRouter shows on
# your usage dashboard, and used to build absolute links in answers.
OPENROUTER_SITE=https://indusmova.pages.dev
