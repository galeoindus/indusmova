# indusmova — local Cloudflare Pages Functions configuration.
# Keep actual keys in your local untracked .env file or as encrypted
# Cloudflare Pages Secrets. Never put live values in this example file.
# Use either .env or .dev.vars locally, not both.

# ── OpenRouter keys ───────────────────────────────────────────────────────
# Create up to six API keys and add them as Cloudflare Secrets.
# The server tries them with best-effort round-robin and failover.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=

# ── model choice ──────────────────────────────────────────────────────────
# Leave everything in this block empty to let the site answer with the
# cheapest model OpenRouter actually serves. That is the recommended default.

# One pinned model. Set it only if every answer must come from one model;
# it overrides both the allowlist and the reader's own choice.
OPENROUTER_MODEL=

# The models the reader may pick between in the chat's model menu.
# Comma-separated OpenRouter ids, any number. Empty = the built-in catalogue
# (Llama 3.2 3B, Gemini 2.0 Flash Lite, GPT-4o mini, Mistral Small,
# Claude 3.5 Haiku, Gemini 2.0 Flash, Llama 3.3 70B, DeepSeek Chat,
# Qwen 2.5 72B, Claude 3.5 Sonnet).
# Example: OPENROUTER_MODELS=openai/gpt-4o-mini,google/gemini-2.0-flash-001
OPENROUTER_MODELS=

# The cheapest cost band the automatic pick may use:
#   cheap    — cheapest models only (default)
#   balanced — start at mid-cost models
#   deep     — start at the highest-quality models
# The answer depth still caps it: Quick never spends more than "cheap",
# Deep may reach the top of the allowed band.
OPENROUTER_MODEL_TIER=cheap

# Model for ordinary conversation turns ("hi", "what can you do"). Empty =
# the same cheap-first automatic pick as a question.
CHAT_MODEL=

# auto = OpenRouter first, then Workers AI; openrouter = only OpenRouter;
# workers-ai = only Cloudflare Workers AI.
AI_PROVIDER=auto
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Used for OpenRouter app attribution (not a secret).
SITE_ORIGIN=https://indusmova.pages.dev
