# indusmova — local Cloudflare Pages Functions configuration.
# Keep actual keys in your local untracked .env file or as encrypted
# Cloudflare Pages Secrets. Never put live values in this example file.
# Use either .env or .dev.vars locally, not both.

# OpenRouter: create up to six API keys and add them as Cloudflare Secrets.
# The server tries them with best-effort round-robin and failover.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=

# OpenRouter model ID (choose an available model in your OpenRouter account).
OPENROUTER_MODEL=openai/gpt-4o-mini

# auto = OpenRouter first, then Workers AI; openrouter = only OpenRouter;
# workers-ai = only Cloudflare Workers AI.
AI_PROVIDER=auto
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Used for OpenRouter app attribution (not a secret).
SITE_ORIGIN=https://indusmova.pages.dev
