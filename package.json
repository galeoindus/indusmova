{
  "name": "indusmova",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "indusmova \u2014 a Wikimedia knowledge research and discovery platform. Ask a question or open a topic and get a direct answer, key points, a topic-wise breakdown, real facts and the sources behind them.",
  "homepage": "https://indusmova.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/galeoindus/indusmova.git"
  },
  "license": "MIT",
  "keywords": [
    "wikipedia",
    "wikidata",
    "knowledge",
    "search",
    "reader",
    "cloudflare-pages",
    "pwa"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "python3 -m http.server 4173",
    "serve": "python3 -m http.server 4173",
    "check": "node scripts/check.mjs",
    "test": "node --test test/",
    "verify": "npm run check && npm run test",
    "articles": "python3 scripts/gen_articles.py"
  },
  "devDependencies": {}
}
