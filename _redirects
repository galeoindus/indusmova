# indusmova — Cloudflare Pages redirects.
# The app is one document; these keep old-style deep links working and give the
# crawlable index pages a canonical trailing slash.

/ask            /#/ask            302
/explore        /#/explore        302
/today          /#/today          302
/saved          /#/bookmarks      302
/bookmarks      /#/bookmarks      302
/sources        /#/sources        302
/about          /#/about          302

# Galeoindus is replaced by the Research Desk. Old addresses keep working.
/galeoindus     /research/        301
/chat           /research/        301
/chat/*         /research/        301

# A real article path. Pages rewrites it to the app shell, which reads the
# slug out of the address bar, so the URL stays clean and shareable.
/articles/*     /index.html       200

/topics         /topics/          301
/questions      /questions/       301
/how-it-works   /how-it-works/    301
/help           /help/            301

