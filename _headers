# indusmova — Cloudflare Pages headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The rule this file follows: a page must never be served from a cache it
# cannot revalidate. The document, the service worker and the build stamp
# are no-store at the browser AND at the edge; the code revalidates on every
# load; only images and icons, which really do not change, keep a long cache.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
  X-Permitted-Cross-Domain-Policies: none
  Permissions-Policy: geolocation=(), camera=(), microphone=(self), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; worker-src 'self' blob:; child-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://upload.wikimedia.org https://thumb.wikimedia.org https://*.wikimedia.org https://*.wikipedia.org https://covers.openlibrary.org; connect-src 'self' https://cloudflareinsights.com https://*.wikipedia.org https://*.wikiquote.org https://*.wikisource.org https://*.wikinews.org https://*.wikibooks.org https://*.wikiversity.org https://*.wikivoyage.org https://*.wiktionary.org https://www.wikidata.org https://commons.wikimedia.org https://wikimedia.org https://*.wikimedia.org https://gutendex.com https://openlibrary.org https://covers.openlibrary.org https://archive.org https://api.crossref.org https://api.openalex.org https://openalex.org https://www.ebi.ac.uk https://eutils.ncbi.nlm.nih.gov https://europepmc.org https://doaj.org https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co; manifest-src 'self'; media-src 'self' https://upload.wikimedia.org; upgrade-insecure-requests

# ── the document: never cached, at the browser or at the edge ─────────────
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/chat/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/chat/index.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

# the build stamp the page polls to notice a new deploy
/assets/version.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
  X-Robots-Tag: all

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# ── the service worker: must be re-fetched, or it keeps serving the old app ─
/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  CDN-Cache-Control: no-store

# ── code: always revalidate, never trust a stored copy blindly ────────────
/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# the versioned alias every page actually requests
/assets/v3/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store

# ── images and icons: these really do not change ─────────────────────────
/assets/img/*
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

# ── the article pages are content, so they revalidate but may be stored ───
/articles/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
